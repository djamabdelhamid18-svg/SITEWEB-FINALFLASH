# Environment variables template — copy this to .env and fill in the values
# Never commit .env to git

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/finalflash

# Admin key — use a long random string, never the default
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

# Allowed origins for CORS (comma-separated)
# CORS_ALLOWED_ORIGINS=https://finalflash.dz,https://www.finalflash.dz

# Port for the API server (default: 3000)
# PORT=3000

# Telegram Instant Order Notifications (Optional)
# 1. Talk to @BotFather on Telegram -> /newbot -> Copy the HTTP API token
# 2. Get your personal or group chat ID via @userinfobot or by adding bot to your channel
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
